# Normalize line endings: text files use LF in the repo, native on checkout.
* text=auto

# Lockfiles and lockfile-like artifacts are always LF.
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.ps1 text eol=crlf
