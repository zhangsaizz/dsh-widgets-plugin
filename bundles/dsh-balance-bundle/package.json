{
  "name": "@dsh-plugins/balance-bundle",
  "description": "Installable dsh bundle: mounts the one balance plugin (seam + vendors + web dashboard), the token-crit widget, and the widgets manager in one layer",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@dsh-plugins/balance": "workspace:*",
    "@dsh-plugins/client-ui-token-crit": "workspace:*",
    "@dsh-plugins/client-ui-widget-manager": "workspace:*"
  }
}
