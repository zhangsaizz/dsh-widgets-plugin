{
  "name": "@dsh-plugins/dsh-widgets-plugin",
  "description": "Installable dsh bundle: mounts all widgets in one layer — the balance plugin (seam + vendors + web dashboard), the token-crit widget, the session monitor widget, the card container widget, the rainbow-flow input widget, and the widgets manager",
  "homepage": "https://github.com/zhangsaizz/dsh-widgets-plugin#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "widgets",
    "dashboard",
    "plugin",
    "bundle"
  ],
  "version": "0.1.0",
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangsaizz/dsh-widgets-plugin.git",
    "directory": "bundles/dsh-widgets-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dependencies": {
    "@dsh-plugins/balance": "workspace:*",
    "@dsh-plugins/client-ui-token-crit": "workspace:*",
    "@dsh-plugins/client-ui-session-monitor": "workspace:*",
    "@dsh-plugins/client-ui-widget-manager": "workspace:*",
    "@dsh-plugins/client-ui-card-container": "workspace:*",
    "@dsh-plugins/client-ui-rainbow-flow": "workspace:*"
  }
}
