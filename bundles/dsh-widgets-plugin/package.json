{
  "name": "@dsh-plugins/dsh-widgets-plugin",
  "description": "Installable dsh bundle: mounts all widgets in one layer — the balance plugin (seam + vendors + web dashboard), the token-crit widget, the session monitor widget, the card container widget, and the widgets manager",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangsaizz/dsh-widgets-plugin.git",
    "directory": "bundles/dsh-widgets-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@dsh-plugins/balance": "workspace:*",
    "@dsh-plugins/client-ui-token-crit": "workspace:*",
    "@dsh-plugins/client-ui-session-monitor": "workspace:*",
    "@dsh-plugins/client-ui-widget-manager": "workspace:*",
    "@dsh-plugins/client-ui-card-container": "workspace:*"
  }
}
