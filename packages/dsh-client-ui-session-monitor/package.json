{
  "name": "@dsh-plugins/client-ui-session-monitor",
  "description": "Session monitor dashboard (web): floating list of running/finished sessions, proactive round-completion toasts with jump-to-session, and a config panel",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangsaizz/dsh-widgets-plugin.git",
    "directory": "packages/dsh-client-ui-session-monitor"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-job-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "icon.svg",
    "locale/*.json"
  ],
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@dsh-plugins/client-ui-widget-manager": "workspace:*",
    "@dsh-plugins/client-ui-card-container": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@deepseek-ai/dsh-api-job-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  }
}
