{
  "name": "@dsh-plugins/client-ui-widget-manager",
  "description": "Widget management tab on the harness Plugins page: lists the project widgets with runtime Add (enable) / Close (disable) over the shell.overlay, the per-widget Configure dialog and the install guide",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangsaizz/dsh-widgets-plugin.git",
    "directory": "packages/dsh-client-ui-widget-manager"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "icon.svg",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.5",
    "react": "^18.2.0"
  }
}
